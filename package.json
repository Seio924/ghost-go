{
  "name": "ghost-go",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "preinstall": "npx only-allow pnpm",
    "type-check": "tsc -b --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-all": "pnpm run lint && pnpm run type-check && pnpm run test"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "i18next": "^27.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^4.0.2",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@babel/core": "^8.1.2",
    "@eslint-react/eslint-plugin": "^5.30.3",
    "@rolldown/plugin-babel": "^0.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-better-tailwindcss": "^4.11.0",
    "eslint-plugin-react-refresh": "^0.5.8",
    "jsdom": "^31.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
